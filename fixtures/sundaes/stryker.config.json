{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "packageManager": "npm",
    "testRunner": "vitest",
    "vitest": {
        "configFile": "vite.config.ts"
    },
    "reporters": ["html", "clear-text", "progress", "json"],
    "htmlReporter": {
        "fileName": "../../reports/mutation/index.html"
    },
    "jsonReporter": {
        "fileName": "../../reports/mutation/mutation.json"
    },
    "coverageAnalysis": "perTest",
    "timeoutMS": 60000,
    "concurrency": 4,
    "mutate": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "!src/**/*.test.tsx",
        "!src/pages/example/**",
        "!src/main.tsx",
        "!src/setupVitest.ts",
        "!src/app/apiMockServer.ts",
        "!src/app/apiMockHandler.ts",
        "!src/shared/lib/testing-library-utils.tsx",
        "!src/**/index.ts",
        "!src/vite-env.d.ts",
        "!src/shared/type/**"
    ]
}
